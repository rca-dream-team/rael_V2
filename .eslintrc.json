{
   "extends": ["next/core-web-vitals", "prettier"],
   "plugins": ["prettier"],
   "rules": {
      "prettier/prettier": "warn",
      "react/no-unescaped-entities": "off",
      "no-unused-vars": "warn",
      "react-hooks/exhaustive-deps": "warn"
   },
   "overrides": [
      {
         "files": ["src/**/*.ts", "src/**/*.tsx"],
         "excludedFiles": ["*.js", "*.jsx", "*.json", "*.config.js"]
      }
   ],
   "ignorePatterns": ["./src/cms/**/*"]
}
